<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo reference="${prefix_}lf_caster"><mu1 value="0.1"/><mu2 value="0.1"/></gazebo>
    <gazebo reference="${prefix_}rf_caster"><mu1 value="0.1"/><mu2 value="0.1"/></gazebo>
    <gazebo reference="${prefix_}lb_caster"><mu1 value="0.1"/><mu2 value="0.1"/></gazebo>
    <gazebo reference="${prefix_}rb_caster"><mu1 value="0.1"/><mu2 value="0.1"/></gazebo>

    <gazebo reference="${prefix_}l_wheel">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="${prefix_}r_wheel">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>${prefix_}l_wheel_amr</left_joint>
            <right_joint>${prefix_}r_wheel_amr</right_joint>
            <wheel_separation>0.90</wheel_separation>
            <wheel_radius>0.08</wheel_radius>
            <frame_id>${prefix_}odom</frame_id>
            <child_frame_id>${prefix_}base_link</child_frame_id>
            <topic>/${prefix_}cmd_vel</topic>
            <odom_topic>/${prefix_}odom</odom_topic>
            <odom_publish_frequency>50</odom_publish_frequency>
            <tf_topic>/${prefix_}tf</tf_topic>
            <max_linear_acceleration>1.0</max_linear_acceleration>
            <max_angular_acceleration>2.0</max_angular_acceleration>
            <max_linear_velocity>0.5</max_linear_velocity>
            <max_angular_velocity>1.0</max_angular_velocity>
            <min_linear_velocity>-0.5</min_linear_velocity>
            <min_angular_velocity>-1.0</min_angular_velocity>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <joint_name>${prefix_}l_wheel_amr</joint_name>
            <joint_name>${prefix_}r_wheel_amr</joint_name>
            <joint_name>${prefix_}lift_amr_body</joint_name>
        </plugin>
    </gazebo>

    <!-- gz-sim-sensors-system is NOT declared here: it owns the shared
         rendering scene, so it must be loaded exactly once per world (see
         world/maze.sdf), not once per spawned robot model. Two copies (e.g.
         one per robot in a multi-robot bringup) crash with "Scene already
         exists with name: scene". -->
</robot>
