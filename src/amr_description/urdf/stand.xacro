<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="${prefix_}stand_link">
        <visual>
            <origin xyz="0.0 0.0 -0.24" rpy="0.0 0.0 0.0" />
            <geometry>
                <mesh filename="package://amr_description/meshes/stand_rack.stl"
                      scale="0.001 0.001 0.001" />  
            </geometry>

        </visual>

        <!--COLLISION TAG-->
        <collision>
            <origin xyz="0.0 0.0 -0.24" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://amr_description/meshes/stand_rack.stl"
                      scale="0.001 0.001 0.001" />  
            </geometry>        
        </collision>

        <!--Inertial Tag-->
        <xacro:box_inertia m="240.0" l="1.250" w="0.9" h="0.26"
                            xyz="0.0 0.0 0.13" rpy="0.0 0.0 0.0" />
    </link>

    <!-- CAMERA JOINT -->
    <joint name="${prefix_}stand_joint" type="fixed">
        <parent link="${prefix_}base_link" />
        <child link="${prefix_}stand_link" />
        <origin xyz="0.0 0.0 0.27" rpy="0 0 0" />
    </joint>


</robot>
